## WeUP — Example environment variables
# Copy to .env.local for development or configure in your deployment system.

# ------------------------
# Public (client-safe) variables — safe to import into client code.
# ------------------------
# Public Mapbox token (REQUIRED)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Base URL frontend uses to call the API. Defaults to '/'
NEXT_PUBLIC_API_BASE_URL=/
# Set to 'true' to enable client-side analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Optional backend analytics endpoint used by /api/analytics proxy
NEXT_PUBLIC_BACKEND_ANALYTICS_ENDPOINT=
# Optional: JSON object or comma-separated list of feature flags
# Example JSON: {"newMapUI":true,"enableBetaFeeds":false}
NEXT_PUBLIC_FEATURE_FLAGS=

# ------------------------
# Server-only secrets (DO NOT commit real secrets)
# These must NOT be prefixed with NEXT_PUBLIC_. Provide them via CI/CD.
# ------------------------
# MAPBOX_SECRET=
# API_KEY=
# API_URL=http://localhost:5000
# DISABLE_HMR=false
# OpenTelemetry OTLP endpoint (required when WeUP__Release__RequireTelemetryExportEndpoint=true)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Release mode gate (set true only in hardened deploy environments)
# WeUP__Release__Enabled=false
