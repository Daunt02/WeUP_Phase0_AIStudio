# Public (safe for client) - these keys are prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Set to 'true' to enable analytics tracking (client-side)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Optional: JSON object or comma-separated list of feature flags
# Example JSON: {"newMapUI":true,"enableBetaFeeds":false}
NEXT_PUBLIC_FEATURE_FLAGS=

# Server-only (do NOT expose to client)
# MAPBOX_SECRET=your_mapbox_secret_here
# API_KEY=your_internal_api_key
# DISABLE_HMR=true
# Mapbox Access Token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
