{
  "name": "mapbox-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "cross-env NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=$NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN NEXT_PUBLIC_API_BASE_URL=/ WEUP_BACKEND_URL=http://127.0.0.1:5074 next dev --hostname 127.0.0.1 --port 3000",
    "dev:frontend:test": "cross-env NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=$NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN NEXT_PUBLIC_API_BASE_URL=/ WEUP_BACKEND_URL=http://127.0.0.1:5074 next dev --hostname 127.0.0.1 --port 3000",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs postgres",
    "dev:backend": "cross-env ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://127.0.0.1:5074 dotnet run --project backend/WeUP.Api/WeUP.Api.csproj",
    "dev:backend:stub": "cross-env ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://127.0.0.1:5074 WeUP__PersistenceMode=Stub SeedData__EnableOnStartup=true SeedData__EnableResetEndpoint=true dotnet run --project backend/WeUP.Api/WeUP.Api.csproj",
    "dev:backend:test": "cross-env ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://127.0.0.1:5074 SeedData__EnableOnStartup=true SeedData__EnableResetEndpoint=true dotnet run --project backend/WeUP.Api/WeUP.Api.csproj",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:frontend": "jest --runInBand",
    "test:backend": "dotnet test backend/WeUP.Tests/WeUP.Tests.csproj --configuration Release",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/run-smoke-local.mjs",
    "test:smoke:deployed": "node scripts/run-smoke.mjs --deployed",
    "validate:schema": "jest --testPathPattern=schemaValidators --runInBand",
    "seed-data": "node scripts/reset-seed.mjs",
    "release:validate-env": "node scripts/release-validate.mjs",
    "release:check": "npm run release:validate-env && npm run typecheck && npm run lint && npm run validate:schema && npm run test:frontend && npm run test:backend && npm run test:e2e && npm run test:smoke"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "mapbox-gl": "^3.0.0",
    "motion": "12.36.0",
    "next": "15.5.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^7.1.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "use-supercluster": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.11",
    "ts-jest": "^29.4.9",
    "typescript": "5.9.3"
  }
}
