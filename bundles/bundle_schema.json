{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Bundle Schema",
  "type": "object",
  "required": ["id", "name", "description", "prompts", "environment"],
  "properties": {
    "id": {"type": "string", "description": "Unique identifier for the bundle"},
    "name": {"type": "string", "description": "Human‑readable name"},
    "description": {"type": "string", "description": "Short description of the bundle's purpose"},
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "assistant", "user"], "description": "Message role"},
          "content": {"type": "string", "description": "Prompt text, may include Jinja2 placeholders"}
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": {"type": "string", "enum": ["gemma-3-4b"], "description": "LLM model to use"}
      }
    }
  },
  "additionalProperties": false
}
