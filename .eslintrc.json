{
  "extends": "next",
  "overrides": [
    {
      "files": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "hooks/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "MemberExpression[object.name=process][property.name=env]",
            "message": "Do not access process.env directly in client code. Import from lib/env/public.ts instead."
          }
        ]
      }
    }
  ]
}
