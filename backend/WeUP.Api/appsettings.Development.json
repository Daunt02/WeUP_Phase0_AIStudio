{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "WeUpDb": "Host=127.0.0.1;Port=54329;Database=weup_phase0_dev;Username=weup;Password=weup_local_dev"
  },
  "WeUP": {
    "PersistenceMode": "Postgres",
    "Ocr": {
      "UseMock": false
    },
    "Auth": {
      "JwtSecret": "this_is_a_very_long_and_secure_placeholder_secret_for_development_purposes_only"
    },
    "Frontend": {
      "AllowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"]
    },
    "Database": {
      "ConnectionStringName": "WeUpDb",
      "AutoApplyMigrations": true,
      "RequireConnectivity": true,
      "FailOnPendingMigrations": true
    },
    "Release": {
      "Enabled": false,
      "RequireDatabaseRuntime": true,
      "RequireAuthService": true,
      "RequireTelemetryExportEndpoint": false,
      "RequireContractManifestValidation": true,
      "ContractManifestPath": "contracts/backend-contract-manifest.json"
    }
  },
  "SeedData": {
    "EnableOnStartup": true,
    "EnableResetEndpoint": true,
    "DatasetPath": "..\\..\\seed\\phase0-dataset.json"
  }
}
