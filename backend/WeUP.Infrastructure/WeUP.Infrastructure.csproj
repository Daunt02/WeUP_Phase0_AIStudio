<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeUP.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WeUP.Contracts\WeUP.Contracts.csproj" />
    <ProjectReference Include="..\WeUP.Domain\WeUP.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core + PostgreSQL provider (P08) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <!-- IHttpClientFactory for ingestion adapters (P10) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.*" />
  </ItemGroup>
</Project>
