<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeUP.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WeUP.Contracts\WeUP.Contracts.csproj" />
    <ProjectReference Include="..\WeUP.Domain\WeUP.Domain.csproj" />
    <!-- Infrastructure reference required: DeduplicationService uses WeUpDbContext directly (P12) -->
    <ProjectReference Include="..\WeUP.Infrastructure\WeUP.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core LINQ extension methods used in DeduplicationService -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
  </ItemGroup>
</Project>
